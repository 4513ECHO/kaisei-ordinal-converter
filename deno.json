{
  "compilerOptions": {
    "lib": [
      "dom",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ],
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ],
      "include": [
        "eqeqeq",
        "no-await-in-loop"
      ],
      "exclude": [
        "fresh-handler-export"
      ]
    }
  },
  "imports": {
    "@/": "./",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@preact/signals": "npm:@preact/signals@^2.11.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "clsx": "npm:clsx@^2.1.1",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "lucide-react": "npm:lucide-react@^1.51.0",
    "preact": "npm:preact@^10.29.8",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^6.4.3",
    "vite-plugin-lucide-preprocess": "npm:vite-plugin-lucide-preprocess@^1.8.0"
  },
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check .",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  }
}
